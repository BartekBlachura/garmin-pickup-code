import Toybox.Lang;
import Toybox.Math;
import Toybox.System;
import Toybox.WatchUi;

// The Instinct code is chosen at build time, not detected on the watch.
// monkey.jungle (generated by tools/gen-products.js from the SDK device
// profiles) excludes annotations per watch:
//
//   :octagon      semi-octagon screen (display.shape in the profile): the
//                 Instinct 2/2S/2X, 3 Solar, E 40/45 mm, Crossover and the
//                 Descent G1. Rounded corners and the sub-window.
//   :hands        analog hands (analogHands in the profile): the Instinct
//                 Crossover and Crossover AMOLED.
//   :notOctagon, :noHands
//                 the versions for every other watch.
//
// So every other watch builds exactly the code it built before the Instinct
// family came in (v0.5). Shared code tests
// OCTAGON and HANDS, constants that the compiler folds: with -O 2 a block
// under a false one is dropped with all it references. What it references
// must still exist, so each Instinct member has a zero-valued private
// constant of the same name on the other watches (unused constants cost
// nothing), and Instinct-only functions are called behind
// `self has :name`, which the type checker accepts for a symbol that the
// build left out. Such a function must be `hidden`, not `private`: `has`
// does not see private symbols, so the call would never run (the compiler
// warns). The compiler does not drop "0 +": an offset that is 0 elsewhere
// goes through `OCTAGON ? ... : ...` with the main form after the colon.
// A block to drop on the Instinct goes under `if (!OCTAGON)`: the compiler
// drops it there and leaves no test elsewhere. It does not drop code after
// a return, nor an else, under a condition folded to true
// (`if (OCTAGON ? true : x) {...; return;}` keeps what follows).
(:notOctagon)
const OCTAGON = false;
(:octagon)
const OCTAGON = true;
(:noHands)
const HANDS = false;
(:hands)
const HANDS = true;

// Parts of the physical semi-octagon screen that text must avoid: the cut
// corners and the round sub-window in the top right corner with the ring
// around it, as the device image of each SDK profile shows them
// (tools/screen-shape.js). The values per watch are constants in
// ScreenGeom, generated from the profiles (writeScreenGeoms in
// tools/gen-products.js): working them out on the watch cost memory that
// the Instinct 2 does not have.
(:octagon)
module Screen {

    // How far the screen edge is pushed inwards, on both sides, at row y
    // by the cut corners; 0 in the straight part of the edge. The corner is
    // an arc through (C, 0) and (0, C) centred at (A, A), with R2 its
    // radius squared (ScreenGeom.CORNER_*).
    function cornerInset(h as Number, y as Number) as Number {
        // Distance of the row into the corner band from the top or bottom.
        var k = y < h / 2 ? y : h - 1 - y;
        if (k >= ScreenGeom.CORNER_C) {
            return 0;
        }
        if (k <= 0) {
            return ScreenGeom.CORNER_C;
        }
        var d = ScreenGeom.CORNER_A - k;
        return ScreenGeom.CORNER_A - Math.sqrt((ScreenGeom.CORNER_R2 - d * d).toFloat()).toNumber();
    }

    // Right end, in a Picker title area of the given width, of the part clear
    // of the sub-window, or the whole width. The title is in the rows of the
    // sub-window on the Instinct 2/2S/2X and Descent G1 (CIQ 3.4: y 21-51),
    // where it ends at ScreenGeom.TITLE_END on the screen, 2 px before the
    // ring in the device image; on the Instinct 3 Solar and E (CIQ 6) it
    // sits at y 63-77, under it, and on the Crossover there is no
    // sub-window (TITLE_END 0). The API does not give the area's position; it
    // is centred on the screen.
    function titleRight(areaW as Number) as Number {
        if (ScreenGeom.TITLE_END == 0) {
            return areaW;
        }
        return ScreenGeom.TITLE_END - (ScreenGeom.SCREEN_W - areaW) / 2;
    }
}
