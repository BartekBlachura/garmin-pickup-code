project.manifest = manifest.xml

# Only the project sources: without this the compiler also picks up every
# .mc file under .claude/worktrees. titletop/y0 holds the PICKER_TITLE_TOP
# of most watches, qrlayout/search finds the QR layout at run time; the
# watches that need otherwise point elsewhere below. settings/phone holds
# the phone app settings; the watches with analog hands use settings/hands
# instead, without the InPost QR toggle.
base.resourcePath = resources;settings/phone
base.sourcePath = source;titletop/y0;qrlayout/search

# The optimisation of release builds (-O 2) for debug builds too, which
# otherwise get -O 1: less code in the simulator, where the 32 KB data field
# limit is tightest (debug information).
project.optimization = 2

# GENERATED by tools/gen-products.js from the SDK device profiles; edit the
# script, not this file. Products: every SDK watch profile with Connect IQ
# >= 3.2.0 and a round or rectangular screen, plus the semi-octagon Instinct
# family and Descent G1 (see docs/INSTINCT.md), without the watches without
# usable on-watch entry, narrowed to the RELEASE list in the script while it
# is set.

# Launcher icon: one SVG per icon size required by the device profiles
# (launcherIcon in compiler.json), so the compiler never scales it. The base
# resources carry no icon; every product must point at one below.

# 26x26
instinctcrossover.resourcePath = resources;settings/hands;icons/26x26

# 30x30
legacyherocaptainmarvel.resourcePath = $(legacyherocaptainmarvel.resourcePath);icons/30x30
